# -*- coding: utf-8 -*-
r"""
config_local.py.example - PLANTILLA de configuración privada de Miku (NO se sube al repo).

Para usarla: copiá este archivo como ``config_local.py`` (en la raíz del proyecto) y completá
lo que necesites. ``config_local.py`` está en .gitignore porque guarda claves y rutas tuyas.

Reglas simples:
  * Todas las opciones van en MAYÚSCULAS.
  * Una línea que empieza con ``#`` está desactivada: Miku usa el valor por defecto.
    Para cambiar una opción, sacale el ``#`` y poné tu valor.
  * Las rutas de Windows se escriben con una ``r`` delante: r"D:\Capturas".
  * Para ver qué opciones tenés, cuáles faltan y cuáles no están bien escritas:
        python -m miku.ajustes estado
  * Para agregar a TU archivo las opciones nuevas (como comentarios, sin tocar tus valores):
        python -m miku.ajustes completar

NUNCA pongas valores reales en este archivo .example ni en ningún archivo versionado.
Este archivo se GENERA desde miku/ajustes/esquema.py: no lo edites a mano
(regenerarlo: python -m miku.ajustes ejemplo).
"""

# ======================================================================================
# Claves de API y cuentas
# ======================================================================================

# Clave de Groq (https://console.groq.com): es el cerebro (LLM) de Miku. Sin ella solo
# funcionan los comandos locales (hora, calculadora, sistema).
# (usado por: cerebro)
GROQ_API_KEY = ""

# Clave de Groq para la transcripción de voz (Whisper) y la traducción de la voz. Si la
# dejás vacía se usa la principal.
# (usado por: voz)
GROQ_API_KEY_STT = ""

# Modelo de Groq que usa el cerebro (debe soportar herramientas/tools).
# (usado por: cerebro)
# MODELO_API_EXTERNA = "openai/gpt-oss-20b"

# Clave de Google AI Studio (https://aistudio.google.com) para que Miku pueda MIRAR la
# pantalla (`ver_pantalla`). OJO: la captura se envía a Google. No hace falta para leer
# texto de la pantalla (eso es OCR local).
# (usado por: vision)
GEMINI_API_KEY = ""

# Modelo de visión de Gemini.
# (usado por: vision)
# GEMINI_MODELO = "gemini-2.0-flash"

# Token personal de Todoist (Ajustes > Integraciones > Desarrollador). El plan gratis
# alcanza.
# (usado por: todoist)
TODOIST_API_TOKEN = ""

# Token del bot de Telegram (lo crea @BotFather) para controlar Miku desde el celular.
# (usado por: telegram_control)
TELEGRAM_BOT_TOKEN = ""

# Tu ID NUMÉRICO de usuario de Telegram (p. ej. con @userinfobot). Miku solo obedece a
# ese usuario.
# (usado por: telegram_control)
# TELEGRAM_CHAT_ID = ""

# Token del bot de Discord (https://discord.com/developers/applications). Necesita el
# intent privilegiado 'Server Members' activado.
# (usado por: discord_control)
DISCORD_BOT_TOKEN = ""

# Clave del servidor LLM propio (los servidores locales no la necesitan).
# (usado por: parser)
LLM_API_KEY = ""


# ======================================================================================
# Voz, micrófono y modo de arranque
# ======================================================================================

# Dirección del motor de voz VOICEVOX.
# (usado por: voz)
# VOICEVOX_URL = "http://localhost:50021"

# Número de la voz de VOICEVOX que usa Miku.
# (usado por: voz)
# VOICEVOX_SPEAKER_ID = 6

# Ruta a run.exe de VOICEVOX si no está en extern/VOICEVOX/vv-engine/. Miku lo arranca
# sola (oculto) si no está corriendo.
# (usado por: voz)
# VOICEVOX_RUN_EXE = r"D:\Programas\VOICEVOX\vv-engine\run.exe"

# Número del micrófono a usar. None = el predeterminado de Windows. La lista de
# micrófonos aparece en la consola al iniciar el modo voz.
# (usado por: voz)
# MICROFONO_INDEX = 2

# Modelo de Whisper para detectar la palabra 'Miku'.
# (usado por: voz)
# MODELO_STT_WAKE = "whisper-large-v3"

# Modelo de Whisper para transcribir lo que le pedís.
# (usado por: voz)
# MODELO_STT_COMANDO = "whisper-large-v3"

# Servidor del LLM compatible con OpenAI. Vacío = Groq. Para un modelo LOCAL: Ollama
# 'http://localhost:11434/v1' o LM Studio 'http://localhost:1234/v1'.
# (usado por: parser)
# LLM_BASE_URL = "http://localhost:11434/v1"

# Modelo a usar con ese servidor (vacío = MODELO_API_EXTERNA). Ej. Ollama: 'qwen2.5:7b'.
# (usado por: parser)
# LLM_MODELO = ""

# False si tu modelo local no entiende herramientas (function calling): Miku conversa
# pero no ejecuta acciones con él.
# (usado por: parser)
# LLM_SOPORTA_TOOLS = True

# Quién transcribe lo que decís: 'groq' (Whisper en la nube) o 'local' (faster-whisper
# en tu PC: sin nube, más lento; pip install faster-whisper).
# Valores válidos: groq, local
# (usado por: voz)
# STT_PROVEEDOR = "groq"

# Tamaño del modelo de faster-whisper cuando STT_PROVEEDOR = 'local' (tiny, base, small,
# medium, large-v3).
# (usado por: voz)
# STT_MODELO_LOCAL = "small"

# Motor de voz: 'voicevox' (voz japonesa, Miku traduce lo que dice), 'sistema' (voz de
# Windows, español) o 'comando' (tu propio motor: ver TTS_COMANDO).
# Valores válidos: voicevox, sistema, comando
# (usado por: voz)
# TTS_MOTOR = "voicevox"

# Idioma que HABLA el motor 'comando' (es, en, ja, pt…). Si no es 'es', Miku traduce
# antes de hablar.
# (usado por: voz)
# TTS_IDIOMA = "es"

# Comando de tu motor de voz (Piper, XTTS, GPT-SoVITS…). Debe escribir un WAV en
# {salida}; el texto entra por stdin (o usá {texto}).
# (usado por: voz)
# TTS_COMANDO = r"piper --model C:\voces\es.onnx --output_file {salida}"

# Subtítulos en pantalla: 'auto' (solo cuando Miku NO habla en español), 'siempre' o
# 'nunca'.
# Valores válidos: auto, siempre, nunca
# (usado por: voz)
# SUBTITULOS = "auto"

# Modo con el que arranca cuando no se elige uno en la ventanita (o con --silencioso):
# 'voz' (escucha continua, decís "Miku") o 'texto' (ventana de depuración). Se puede
# cambiar desde el icono de la bandeja.
# Valores válidos: voz, texto
# (usado por: app)
# MODO_ENTRADA = "voz"

# Tecla que te invoca (saluda y escucha un comando). F22 por defecto; si tu teclado no
# la tiene usá 'Elegir tecla de invocación…' en la bandeja (detecta la que aprietes) o
# poné un nombre como 'f13' o 'ctrl+alt+m', o 'sc:NN' para una tecla especial. Solo
# funciona con Miku abierta, salvo F22 con el atajo de Windows.
# (usado por: app)
# TECLA_INVOCAR = "f22"

# Al iniciar el modo voz, Miku saluda con la hora, el clima y tus pendientes. Ponelo en
# False si no querés que hable al arrancar con Windows.
# (usado por: app)
# SALUDO_AL_INICIAR = True

# Detalle de los mensajes de diagnóstico: DEBUG, INFO, WARNING o ERROR.
# Valores válidos: DEBUG, INFO, WARNING, ERROR
# (usado por: app)
# LOG_LEVEL = "INFO"


# ======================================================================================
# Memoria
# ======================================================================================

# Si Miku guarda y recuerda cosas que le pedís ('acordate que…').
# (usado por: memoria)
# MEMORIA_ACTIVA = True

# Búsqueda por SIGNIFICADO en la memoria y en los archivos (requiere `pip install
# fastembed`; si no está instalado se busca por palabras).
# (usado por: memoria)
# EMBEDDINGS_ACTIVOS = True

# Qué tan parecido (0 a 1) debe ser un recuerdo para que Miku lo use. Más alto = más
# estricto.
# (usado por: memoria)
# EMBEDDINGS_UMBRAL = 0.35

# Cuántos turnos previos de la charla recuerda Miku para entender 'y mañana?' o 'ahora
# en Chrome' (0 = sin historial).
# (usado por: parser)
# HISTORIAL_TURNOS = 4

# Minutos que un turno sigue contando como contexto de la charla.
# (usado por: parser)
# HISTORIAL_MINUTOS = 10

# Mandarle al LLM solo las herramientas relacionadas con lo que dijiste (menos costo y
# latencia). Si ninguna se relaciona claramente, manda todas.
# (usado por: parser)
# ENRUTAR_TOOLS = True

# Máximo de herramientas que se mandan al LLM por consulta cuando el enrutado está
# activo.
# (usado por: parser)
# ENRUTAR_MAX_TOOLS = 14


# ======================================================================================
# Sistema, programas y juegos
# ======================================================================================

# Apps que Miku puede CERRAR por voz (nombre exacto). El Explorador de Windows nunca se
# cierra aunque esté acá.
# (usado por: programas)
# APP_WHITELIST = ['brave', 'discord', 'tidal', 'vscode', 'code', 'chrome', 'edge', 'spotify', 'steam', 'obs', 'notepad', 'explorer', 'calculadora']

# Ruta a es.exe (Everything CLI) para buscar archivos. Everything tiene que estar
# abierto en segundo plano.
# (usado por: archivos)
# RUTA_EVERYTHING_ES = "bin/es.exe"

# Carpeta de instalación de Steam si no está en la ubicación habitual.
# (usado por: programas)
# STEAM_RUTA = r"D:\Steam"

# Juegos de Epic Games a mano: nombre -> id del ítem (Epic no se detecta solo).
# (usado por: programas)
# JUEGOS_EPIC = {"fortnite": "fn"}


# ======================================================================================
# Carpetas personales
# ======================================================================================

# Carpetas de acceso rápido: 'abrí la carpeta de animes'. También podés enseñarlas por
# voz y se guardan solas.
# (usado por: favoritos)
# CARPETAS_FAVORITAS = {"animes": r"R:\Animes", "descargas": r"C:\Users\vos\Downloads"}

# Dónde se guardan las capturas de pantalla. Vacío = data/capturas/ dentro del proyecto.
# (usado por: captura)
# CARPETA_CAPTURAS = r"D:\Capturas"


# ======================================================================================
# Capturas, OCR y visión
# ======================================================================================

# Ruta a tesseract.exe para leer texto de la pantalla con mejor precisión. Vacío = se
# busca en el PATH y, si no está, se usa el OCR incluido en Windows.
# (usado por: ocr)
# TESSERACT_RUTA = r"C:\Program Files\Tesseract-OCR\tesseract.exe"

# Idioma del OCR de Tesseract: spa, eng o spa+eng.
# (usado por: ocr)
# OCR_IDIOMA = "spa"


# ======================================================================================
# Navegador y música
# ======================================================================================

# Ruta a brave.exe. Miku lo lanza con el puerto de depuración para controlar las
# pestañas.
# (usado por: browser)
# BRAVE_RUTA_EXE = r"C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe"

# Carpeta del perfil de Brave a usar (para abrir con tu sesión).
# (usado por: browser)
# BRAVE_PERFIL_DIR = ""

# Puerto de depuración remota de Brave.
# (usado por: browser)
# BRAVE_DEBUG_PORT = 9222

# Ruta a TIDAL.exe. Para 'poné X' Miku abre TIDAL con un puerto de control (si estaba
# abierto sin él, lo reinicia una vez).
# (usado por: tidal)
# TIDAL_RUTA_EXE = ""

# Puerto de depuración con el que Miku abre TIDAL para poder reproducir temas por
# nombre.
# (usado por: tidal)
# TIDAL_PUERTO_CONTROL = 9223


# ======================================================================================
# Interpolación de video
# ======================================================================================

# Carpeta con los videos a interpolar. Miku solo procesa videos de esta carpeta.
# (usado por: video_interpolador)
# CARPETA_VIDEOS = r"R:\VapourSynth-Env\videos"

# Ruta al .bat que interpola (recibe la ruta completa del video como argumento).
# (usado por: video_interpolador)
# RUTA_BAT_INTERPOLAR = r"R:\VapourSynth-Env\Python\interpolar_miku.bat"


# ======================================================================================
# Traductor de juegos y Game Booster
# ======================================================================================

# Idioma por defecto del traductor cuando no decís uno ('traducí X al portugués' siempre
# gana): 'inglés', 'portugués', 'japonés'… Opcional.
# (usado por: traductor_juegos)
# IDIOMA_JUEGO = ""

# Idioma del traductor por juego: si estás jugando uno de estos y no decís idioma, se
# usa el suyo (tiene prioridad sobre IDIOMA_JUEGO). Clave: proceso sin .exe.
# (usado por: traductor_juegos)
# PERFILES_JUEGO = {"cs2": "portugués", "genshinimpact": "inglés"}

# Atajos del traductor: clave -> frase en español ('gg': 'buena partida'). Opcional.
# (usado por: traductor_juegos)
# MENSAJES_JUEGO = {"gg": "buena partida"}

# Procesos de juegos (sin .exe) que activan el modo gaming automático.
# (usado por: game_booster)
# JUEGOS_BOOSTER = ["cs2", "fortniteclient-win64-shipping", "genshinimpact"]

# Apps a las que baja el volumen el modo gaming.
# (usado por: game_booster)
# BOOSTER_APPS_VOLUMEN = ['brave', 'chrome', 'edge', 'firefox']

# Volumen (0-100) al que se bajan esas apps mientras jugás.
# (usado por: game_booster)
# BOOSTER_VOLUMEN_OBJETIVO = 20

# Avisar (notificación + voz) al entrar y salir del modo gaming.
# (usado por: game_booster)
# BOOSTER_AVISO = True


# ======================================================================================
# Clima y personalidad
# ======================================================================================

# Tu ciudad para el clima (Open-Meteo, sin clave).
# (usado por: clima)
# CIUDAD_CLIMA = ""

# Latitud, si preferís coordenadas exactas en vez de la ciudad.
# (usado por: clima)
# CLIMA_LAT = ""

# Longitud (junto con la latitud).
# (usado por: clima)
# CLIMA_LON = ""

# Estilo de Miku: neutral, tsundere, formal o entusiasta.
# Valores válidos: neutral, tsundere, formal, entusiasta
# (usado por: personalidad)
# PERSONALIDAD = "neutral"


# ======================================================================================
# Tareas, control remoto y avisos automáticos
# ======================================================================================

# Avisos automáticos de Miku (clima, estado de la PC, batería, disco). Es el interruptor
# general.
# (usado por: asistente_proactivo)
# PROACTIVO_ACTIVO = True

# Avisar cuando la batería baje de este porcentaje.
# (usado por: asistente_proactivo)
# PROACTIVO_BATERIA_MIN = 20

# Avisar cuando queden menos de estos GB libres.
# (usado por: asistente_proactivo)
# PROACTIVO_DISCO_GB = 5.0

# Cada cuántos minutos revisa el estado de la PC.
# (usado por: asistente_proactivo)
# PROACTIVO_INTERVALO_MIN = 5

# Minutos mínimos entre dos avisos iguales.
# (usado por: asistente_proactivo)
# PROACTIVO_COOLDOWN_MIN = 30

# Máximo de avisos por hora (para que no moleste). 0 = sin límite.
# (usado por: asistente_proactivo)
# PROACTIVO_MAX_POR_HORA = 4

# Desde qué hora no avisa nada (HH:MM). Vacío junto con la de abajo = sin horario de
# silencio.
# (usado por: asistente_proactivo)
# PROACTIVO_SILENCIO_DESDE = "23:00"

# Hasta qué hora no avisa nada (HH:MM).
# (usado por: asistente_proactivo)
# PROACTIVO_SILENCIO_HASTA = "08:00"

# Mientras jugás solo avisa lo urgente (temperatura de la GPU) y el estado al empezar.
# (usado por: asistente_proactivo)
# PROACTIVO_NO_MOLESTAR_EN_JUEGO = True

# Avisar del clima cuando importa (lluvia, frío o calor fuertes). Necesita CIUDAD_CLIMA
# o CLIMA_LAT/CLIMA_LON. Avisa como mucho una vez por día por cada condición.
# (usado por: asistente_proactivo)
# PROACTIVO_CLIMA = True

# Cada cuántos minutos consulta el pronóstico para los avisos.
# (usado por: asistente_proactivo)
# PROACTIVO_CLIMA_INTERVALO_MIN = 120

# Avisar de lluvia cuando la probabilidad en las próximas horas sea de este % o más.
# (usado por: asistente_proactivo)
# PROACTIVO_LLUVIA_PROB = 60

# Avisar de frío cuando la sensación térmica sea de estos grados o menos.
# (usado por: asistente_proactivo)
# PROACTIVO_FRIO_C = 12

# Avisar de calor cuando la sensación térmica sea de estos grados o más.
# (usado por: asistente_proactivo)
# PROACTIVO_CALOR_C = 32

# Contar cómo está la PC (CPU, RAM, GPU) un rato después de que empieza un juego de
# JUEGOS_BOOSTER.
# (usado por: asistente_proactivo)
# PROACTIVO_ESTADO_JUEGO = True

# Avisar cuando CPU o RAM se mantengan por encima de este % durante unos minutos.
# (usado por: asistente_proactivo)
# PROACTIVO_CARGA_PCT = 92

# Avisar (aunque estés jugando) cuando la GPU NVIDIA pase de estos grados.
# (usado por: asistente_proactivo)
# PROACTIVO_GPU_TEMP_C = 85


# ======================================================================================
# Discord
# ======================================================================================

# ID del servidor de Discord por defecto (clic derecho en el servidor > Copiar ID, con
# el Modo desarrollador activado).
# (usado por: discord_control)
# DISCORD_GUILD_ID = ""

# Reservado: canal por defecto para futuras funciones.
# (usado por: discord_control)
# DISCORD_CANAL_DEFAULT = ""
